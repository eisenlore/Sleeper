  const byPos = new Map();
  const report = [];
  for (const f of files) {
    const objs = csvObjects(f.text);
    if (!objs.length) { report.push(f.name + ': leer'); continue; }
    const keys = Object.keys(objs[0]);
    const lk = keys.map(k => k.toLowerCase());
    const get = (o, k) => { const key = keys.find(x => x.toLowerCase() === k); return key ? o[key] : ''; };
    if (lk.includes('pos') && (lk.includes('value_1qb') || lk.includes('value_sf'))) {
      const rows = objs.map(o => ({ name: get(o, 'name'), pos: String(get(o, 'pos')).toUpperCase(), team: get(o, 'team'), age: numOrNull(get(o, 'age')), v1: numOrNull(get(o, 'value_1qb')), vsf: numOrNull(get(o, 'value_sf')), vtep: numOrNull(get(o, 'value_tep')) })).filter(r => r.name && r.pos);
      for (const pos of new Set(rows.map(r => r.pos))) byPos.set(pos, rows.filter(r => r.pos === pos));
      report.push(f.name + ': ' + rows.length + ' Zeilen');
    } else if (lk.includes('name') && lk.includes('trade value')) {
      const pos = lk.includes('sf value') ? 'QB' : lk.includes('tep value') ? 'TE' : detectPos(objs.map(o => get(o, 'name')));
      if (!pos) { report.push(f.name + ': Position nicht erkannt'); continue; }
      const rows = objs.map(o => {
        const tv = numOrNull(get(o, 'trade value'));
        return { name: get(o, 'name'), pos, team: get(o, 'team'), age: numOrNull(get(o, 'age')), v1: tv, vsf: numOrNull(get(o, 'sf value')) ?? tv, vtep: numOrNull(get(o, 'tep value')) };
      }).filter(r => r.name && r.v1 != null);
      byPos.set(pos, rows);
      report.push(f.name + ': ' + rows.length + ' ' + pos);
    } else report.push(f.name + ': Format nicht erkannt');
  }
  if (!byPos.size) return { ok: false, report };
  const keep = (cur.rows || []).filter(r => !byPos.has(r.pos));
  const rows = keep.concat(...byPos.values());
  const okSave = LS.set('sdd_fp', { rows, importedAt: new Date().toISOString(), label: 'Import ' + new Date().toLocaleDateString('de-DE') });
  if (!okSave) report.push('Speichern im Browser nicht möglich (privates Fenster?)');
  return { ok: okSave, report };
}
