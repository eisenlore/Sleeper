    if (u) myUserId = String(u.user_id);
  }
  progress('sleeper', 'ok', String(league.name || 'Liga'));

  const season = Number(league.season);
  const stSeason = Number(state && state.season);
  let lastWeek = Number(league.settings && league.settings.last_scored_leg) || 0;
  if (!lastWeek) {
    if (stSeason === season && state.season_type === 'regular') lastWeek = Math.max(0, Number(state.week || 1) - 1);
    else if (stSeason === season && (state.season_type === 'post' || state.season_type === 'off')) lastWeek = 18;
    else if (stSeason > season) lastWeek = 18;
  }
  lastWeek = clamp(lastWeek, 0, 18);
  progress('matchups', 'loading');
  const weeks = []; for (let w = 1; w <= lastWeek; w++) weeks.push(w);
  const mus = await Promise.all(weeks.map(w => getJSON(SL + 'league/' + lid + '/matchups/' + w).catch(() => null)));
  const matchups = {};
  weeks.forEach((w, i) => { if (Array.isArray(mus[i]) && mus[i].some(m => Number(m.points) > 0)) matchups[w] = mus[i]; });
  progress('matchups', 'ok', Object.keys(matchups).length + ' Wochen');

  const nextWeek = (stSeason === season && state.season_type === 'regular') ? Number(state.week) : null;
  let proj = null;
  if (nextWeek) {
    progress('proj', 'loading');
    try { proj = await getJSON(SL + 'projections/nfl/regular/' + season + '/' + nextWeek); progress('proj', 'ok', 'Woche ' + nextWeek); }
    catch (e) { progress('proj', 'warn', 'nicht verfügbar'); }
  } else progress('proj', 'warn', 'außerhalb der Regular Season');
  let trending = [];
  try { trending = await getJSON(SL + 'players/nfl/trending/add?lookback_hours=48&limit=60'); } catch (e) { trending = []; }
  return { state, league, users: users || [], rosters: rosters || [], traded: traded || [], drafts: drafts || [], myUserId, matchups, nextWeek, proj, trending: Array.isArray(trending) ? trending : [] };
}

async function loadPlayers(force, rosteredIds, progress) {
