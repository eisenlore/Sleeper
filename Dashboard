<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="robots" content="noindex">
<title>Dynasty Cockpit</title>
<style>
*{box-sizing:border-box}
:root{
  color-scheme:light;
  --page:#f9f9f7;--surface:#fcfcfb;--surface-2:#f2f1ed;--surface-3:#e9e8e3;
  --border:rgba(11,11,11,.10);--ink:#0b0b0b;--ink-2:#52514e;--muted:#898781;
  --grid:#e1e0d9;--axis:#c3c2b7;--accent:#2a78d6;--accent-ink:#ffffff;
  --s1:#2a78d6;--s2:#eb6834;--s3:#1baf7a;--s4:#eda100;--s5:#e87ba4;--s6:#008300;--s7:#6250d6;--s8:#e34948;
  --good:#0ca30c;--warn:#fab219;--serious:#ec835a;--crit:#d03b3b;--good-ink:#006300;--crit-ink:#b12f2f;
  --g-A:#1c5cab;--g-A-ink:#ffffff;--g-B:#3987e5;--g-B-ink:#ffffff;--g-C:#86b6ef;--g-C-ink:#0b0b0b;--g-D:#cde2fb;--g-D-ink:#0b0b0b;--g-F:#f2f1ed;--g-F-ink:#52514e;
  --shadow:0 1px 2px rgba(0,0,0,.04),0 6px 24px rgba(0,0,0,.05);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --page:#0d0d0d;--surface:#1a1a19;--surface-2:#232321;--surface-3:#2c2c2a;
    --border:rgba(255,255,255,.10);--ink:#f0efec;--ink-2:#c3c2b7;--muted:#898781;
    --grid:#2c2c2a;--axis:#383835;--accent:#3987e5;--accent-ink:#ffffff;
    --s1:#3987e5;--s2:#d95926;--s3:#199e70;--s4:#c98500;--s5:#d55181;--s6:#008300;--s7:#9085e9;--s8:#e66767;
    --good-ink:#0ca30c;--crit-ink:#e66767;
    --g-A:#6da7ec;--g-A-ink:#0b0b0b;--g-B:#2a78d6;--g-B-ink:#ffffff;--g-C:#1c5cab;--g-C-ink:#ffffff;--g-D:#104281;--g-D-ink:#f0efec;--g-F:#232321;--g-F-ink:#c3c2b7;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 24px rgba(0,0,0,.3);
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --page:#0d0d0d;--surface:#1a1a19;--surface-2:#232321;--surface-3:#2c2c2a;
  --border:rgba(255,255,255,.10);--ink:#f0efec;--ink-2:#c3c2b7;--muted:#898781;
  --grid:#2c2c2a;--axis:#383835;--accent:#3987e5;--accent-ink:#ffffff;
  --s1:#3987e5;--s2:#d95926;--s3:#199e70;--s4:#c98500;--s5:#d55181;--s6:#008300;--s7:#9085e9;--s8:#e66767;
  --good-ink:#0ca30c;--crit-ink:#e66767;
  --g-A:#6da7ec;--g-A-ink:#0b0b0b;--g-B:#2a78d6;--g-B-ink:#ffffff;--g-C:#1c5cab;--g-C-ink:#ffffff;--g-D:#104281;--g-D-ink:#f0efec;--g-F:#232321;--g-F-ink:#c3c2b7;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 24px rgba(0,0,0,.3);
}
html,body{margin:0;padding:0}
body{background:var(--page);color:var(--ink);font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;-webkit-font-smoothing:antialiased;min-height:100vh}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
button,select,input,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* Kopfbereich */
.topbar{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--page) 90%,transparent);backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--border)}
.topbar-in{max-width:1320px;margin:0 auto;padding:12px 16px 0}
.brand{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-width:0}
.brand .logo{flex:none}
.brand h1{font-size:18px;margin:0;font-weight:650;letter-spacing:-.01em}
.brand .league{color:var(--ink-2);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 2px}
.chip{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;background:var(--surface-2);border:1px solid var(--border);font-size:12px;color:var(--ink-2);white-space:nowrap}
.chip .dot{width:8px;height:8px;border-radius:50%;background:var(--muted)}
.chip.warn .dot{background:var(--warn)}.chip.crit .dot{background:var(--crit)}.chip.good .dot{background:var(--good)}
.controls{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;padding:8px 0}
.ctl{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ink-2)}
.ctl label{white-space:nowrap}
select,input[type=text],input[type=search],textarea{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:6px 8px;max-width:100%}
textarea{width:100%;min-height:90px;font:12px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.seg{display:inline-flex;background:var(--surface-2);border:1px solid var(--border);border-radius:9px;padding:2px;flex-wrap:wrap}
.seg button{border:0;background:transparent;padding:5px 10px;border-radius:7px;cursor:pointer;color:var(--ink-2);white-space:nowrap}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.14)}
.btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);background:var(--surface);border-radius:8px;padding:6px 12px;cursor:pointer;white-space:nowrap}
.btn:hover{background:var(--surface-2)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.primary:hover{filter:brightness(1.06)}
.btn.small{padding:3px 8px;font-size:12px}
.btn[disabled]{opacity:.5;cursor:default}
.iconbtn{border:1px solid var(--border);background:var(--surface);border-radius:8px;width:32px;height:32px;display:inline-grid;place-items:center;cursor:pointer;color:var(--ink-2)}
.spacer{flex:1}
.updated{font-size:12px;color:var(--muted)}
.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;margin:0 -16px;padding:0 16px}
.tabs::-webkit-scrollbar{display:none}
.tabs button{border:0;background:none;padding:10px 12px 9px;cursor:pointer;color:var(--ink-2);border-bottom:2px solid transparent;white-space:nowrap;font-weight:500}
.tabs button:hover{color:var(--ink)}
.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}

/* Inhalt */
main{max-width:1320px;margin:0 auto;padding:16px 16px 48px}
.grid{display:grid;gap:16px;grid-template-columns:repeat(12,minmax(0,1fr))}
.c12{grid-column:span 12}.c8{grid-column:span 8}.c7{grid-column:span 7}.c6{grid-column:span 6}.c5{grid-column:span 5}.c4{grid-column:span 4}.c3{grid-column:span 3}.c2{grid-column:span 2}
@media (max-width:1100px){.c2{grid-column:span 4}}
@media (max-width:1000px){.c8,.c7,.c6,.c5,.c4{grid-column:span 12}.c3{grid-column:span 6}}
@media (max-width:600px){.c3,.c2{grid-column:span 6}}
.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px;min-width:0;box-shadow:var(--shadow)}
.card-h{display:flex;justify-content:space-between;align-items:flex-start;gap:8px 12px;flex-wrap:wrap;margin-bottom:12px}
.card h2{font-size:15px;margin:0;font-weight:650;letter-spacing:-.005em}
.card h3{font-size:13px;margin:12px 0 6px;font-weight:650;color:var(--ink-2)}
.sub{margin:3px 0 0;color:var(--muted);font-size:12px}
.kpi{display:flex;flex-direction:column;gap:2px}
.kpi .label{font-size:12px;color:var(--ink-2)}
.kpi .value{font-size:28px;font-weight:650;letter-spacing:-.02em;line-height:1.15;margin-top:4px}
.kpi .value small{font-size:14px;font-weight:500;color:var(--ink-2);letter-spacing:0}
.kpi .hint{font-size:12px;color:var(--muted)}
.hero .value{font-size:48px}
.lage{font-size:14px;line-height:1.55;margin:0}
.lage li{margin:4px 0}
ul.clean{list-style:none;padding:0;margin:0}
.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.between{display:flex;justify-content:space-between;align-items:center;gap:8px}
.stack{display:flex;flex-direction:column;gap:10px}
.muted{color:var(--muted)}.ink2{color:var(--ink-2)}
.small{font-size:12px}
.nowrap{white-space:nowrap}
.num{font-variant-numeric:tabular-nums}
.good-t{color:var(--good-ink)}.crit-t{color:var(--crit-ink)}

/* Tabellen */
.tbl-wrap{overflow-x:auto;margin:0 -6px;padding:0 6px;-webkit-overflow-scrolling:touch}
table.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{position:sticky;top:0;background:var(--surface);text-align:left;font-weight:600;color:var(--ink-2);font-size:12px;padding:8px;border-bottom:1px solid var(--axis);white-space:nowrap;user-select:none}
.tbl th.sortable{cursor:pointer}
.tbl th.sortable:hover{color:var(--ink)}
.tbl td{padding:7px 8px;border-bottom:1px solid var(--grid);white-space:nowrap;vertical-align:middle}
.tbl td.num,.tbl th.num{text-align:right;font-variant-numeric:tabular-nums}
.tbl td.wrap{white-space:normal;min-width:180px}
.tbl tr.me td{background:color-mix(in srgb,var(--accent) 9%,transparent)}
.tbl tr.dim td{color:var(--muted)}
.tbl tr.clickable{cursor:pointer}
.tbl tr.clickable:hover td{background:var(--surface-2)}
.tbl .pname{font-weight:600}
.tbl .meta{color:var(--muted);font-size:12px;margin-left:6px}

/* Positionen, Signale */
.pos{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:650;color:var(--ink-2);min-width:38px}
.pos::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--pc,var(--muted));flex:none}
.pos-QB{--pc:var(--s1)}.pos-RB{--pc:var(--s2)}.pos-WR{--pc:var(--s3)}.pos-TE{--pc:var(--s4)}.pos-PICK{--pc:var(--s5)}.pos-DL{--pc:var(--s6)}.pos-LB{--pc:var(--s7)}.pos-DB{--pc:var(--s8)}.pos-K,.pos-DEF{--pc:var(--muted)}
.pill{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:600;border:1px solid var(--border);background:var(--surface-2);color:var(--ink);white-space:nowrap}
.pill .ic{font-size:11px;line-height:1}
.pill.sell{background:color-mix(in srgb,var(--s2) 16%,var(--surface))}
.pill.core{background:color-mix(in srgb,var(--s3) 16%,var(--surface))}
.pill.target{background:color-mix(in srgb,var(--s1) 16%,var(--surface))}
.pill.cut,.pill.hold{color:var(--ink-2)}
.inj{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.02em;color:#fff;background:var(--crit);border-radius:4px;padding:0 4px;margin-left:6px;vertical-align:1px}
.inj.q{background:var(--warn);color:#0b0b0b}
.tag{display:inline-block;font-size:11px;color:var(--ink-2);background:var(--surface-2);border:1px solid var(--border);border-radius:5px;padding:0 5px;margin-left:6px}
.grade{display:inline-grid;place-items:center;width:28px;height:24px;border-radius:6px;font-weight:700;font-size:13px}
.grade.A{background:var(--g-A);color:var(--g-A-ink)}.grade.B{background:var(--g-B);color:var(--g-B-ink)}.grade.C{background:var(--g-C);color:var(--g-C-ink)}.grade.D{background:var(--g-D);color:var(--g-D-ink)}.grade.F{background:var(--g-F);color:var(--g-F-ink);border:1px solid var(--border)}
.lock{border:0;background:none;cursor:pointer;color:var(--muted);font-size:14px;padding:2px 4px}
.lock[aria-pressed="true"]{color:var(--ink)}

/* Banner */
.banner{border:1px solid var(--border);border-left:4px solid var(--warn);background:var(--surface);border-radius:10px;padding:10px 12px;margin-bottom:16px;box-shadow:var(--shadow)}
.banner.info{border-left-color:var(--accent)}.banner.crit{border-left-color:var(--crit)}.banner.good{border-left-color:var(--good)}
.banner strong{font-weight:650}

/* Trade-Karten */
.sugg{border:1px solid var(--border);border-radius:12px;padding:12px;background:var(--surface);display:flex;flex-direction:column;gap:8px}
.sugg .sides{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:start}
.sugg .arrow{color:var(--muted);font-size:18px;padding-top:14px}
.sugg .side h4{margin:0 0 4px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.asset{display:grid;grid-template-columns:46px minmax(0,1fr) auto;column-gap:8px;align-items:baseline;padding:3px 0}
.asset .nm{font-weight:600}
.asset .an{min-width:0}
.asset .av{font-variant-numeric:tabular-nums;color:var(--muted);font-size:12px;text-align:right}
.stack16{display:flex;flex-direction:column;gap:16px;min-width:0}
@media (max-width:700px){.topbar{position:static}}
.metrics{display:flex;flex-wrap:wrap;gap:6px}
.metric{font-size:12px;background:var(--surface-2);border-radius:8px;padding:3px 8px;color:var(--ink-2)}
.metric b{color:var(--ink);font-weight:650}
.srcchk{display:flex;flex-wrap:wrap;gap:4px}
.srcchk span{font-size:11px;border:1px solid var(--border);border-radius:6px;padding:1px 6px;color:var(--ink-2)}
.srcchk span.ok::before{content:"✓ ";color:var(--good-ink);font-weight:700}
.srcchk span.no::before{content:"✕ ";color:var(--crit-ink);font-weight:700}
.srcchk span.hi::before{content:"↑ ";color:var(--ink-2);font-weight:700}
@media (max-width:560px){.sugg .sides{grid-template-columns:1fr}.sugg .arrow{display:none}}

/* Trade-Rechner */
.picker{display:flex;flex-direction:column;gap:8px}
.picker .list{max-height:420px;overflow:auto;border:1px solid var(--border);border-radius:10px}
.picker .item{display:flex;align-items:center;gap:8px;padding:6px 10px;border-bottom:1px solid var(--grid);cursor:pointer}
.picker .item:last-child{border-bottom:0}
.picker .item:hover{background:var(--surface-2)}
.picker .item.sel{background:color-mix(in srgb,var(--accent) 12%,transparent)}
.picker .item .v{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--ink-2)}
.chosen{display:flex;flex-wrap:wrap;gap:6px;min-height:30px}
.chosen .ch{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);background:var(--surface-2);border-radius:999px;padding:3px 4px 3px 10px;font-size:12px}
.chosen .ch button{border:0;background:var(--surface-3);border-radius:50%;width:18px;height:18px;cursor:pointer;line-height:1;color:var(--ink-2)}

/* Diagramme */
.chart{width:100%;position:relative}
.chart svg{display:block;width:100%;height:auto;overflow:visible}
.chart text{fill:var(--muted);font-size:11px}
.chart .lbl{fill:var(--ink-2);font-size:11px}
.chart .lbl.me{fill:var(--ink);font-weight:700}
.chart .qlbl{fill:var(--muted);font-size:11px;font-weight:600;letter-spacing:.03em;text-transform:uppercase}
.chart .grid line{stroke:var(--grid);stroke-width:1}
.chart .axis line{stroke:var(--axis);stroke-width:1}
.chart .mid{stroke:var(--axis);stroke-width:1}
.chart .hit{fill:transparent;cursor:pointer}
.chart .dot{stroke:var(--surface);stroke-width:2}
.chart .hl{stroke:var(--ink);stroke-width:2}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin:6px 0 0;font-size:12px;color:var(--ink-2)}
.legend .k{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.legend .k.line{height:2px;border-radius:1px;width:14px;vertical-align:3px}
.legend .k.circle{border-radius:50%}
.spark{display:inline-block;vertical-align:middle}
.spark polyline{fill:none;stroke:var(--s1);stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
.spark circle{fill:var(--s1)}
.tt{position:fixed;z-index:60;display:none;pointer-events:none;background:var(--surface);color:var(--ink);border:1px solid var(--border);border-radius:10px;padding:8px 10px;box-shadow:0 8px 24px rgba(0,0,0,.2);font-size:12px;max-width:300px}
.tt-title{font-weight:650;margin-bottom:4px}
.tt-row{display:flex;align-items:center;gap:6px;line-height:1.5}
.tt-row strong{font-variant-numeric:tabular-nums}
.tt-key{width:12px;height:2px;border-radius:1px;flex:none}
.tt-label{color:var(--ink-2)}

/* Laden, Dialog, Toast */
.loading{max-width:520px;margin:40px auto}
.steps{list-style:none;padding:0;margin:12px 0 0}
.steps li{display:flex;align-items:center;gap:10px;padding:6px 0;border-bottom:1px solid var(--grid);font-size:13px}
.steps li:last-child{border-bottom:0}
.steps .st{width:18px;text-align:center;font-weight:700}
.steps .note{margin-left:auto;color:var(--muted);font-size:12px;text-align:right}
.st.ok{color:var(--good-ink)}.st.err{color:var(--crit-ink)}.st.warn{color:var(--serious)}.st.loading{color:var(--muted)}
@keyframes pulse{0%,100%{opacity:.3}50%{opacity:1}}
.st.loading{animation:pulse 1.2s infinite}
dialog{border:1px solid var(--border);border-radius:16px;background:var(--surface);color:var(--ink);padding:0;max-width:min(720px,calc(100vw - 32px));width:100%;box-shadow:0 24px 64px rgba(0,0,0,.35)}
dialog::backdrop{background:rgba(0,0,0,.45)}
.dlg-h{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:14px 16px;border-bottom:1px solid var(--grid)}
.dlg-h h2{margin:0;font-size:16px}
.dlg-b{padding:16px;max-height:70vh;overflow:auto}
.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:var(--ink);color:var(--page);padding:8px 14px;border-radius:10px;font-size:13px;z-index:70;opacity:0;transition:opacity .2s;pointer-events:none;max-width:calc(100vw - 32px)}
.toast.show{opacity:1}
.foot{max-width:1320px;margin:0 auto;padding:0 16px 32px;color:var(--muted);font-size:12px}
.foot a{color:var(--ink-2)}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:13px}
.kv dt{color:var(--ink-2)}.kv dd{margin:0}
.empty{color:var(--muted);font-size:13px;padding:8px 0}
details.info{margin-top:8px}
details.info summary{cursor:pointer;color:var(--ink-2);font-size:12px}
.srccard{border:1px solid var(--border);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:6px;background:var(--surface)}
.srccard .nm{font-weight:650}
.status{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--ink-2)}
.status::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--muted)}
.status.ok::before{background:var(--good)}.status.error::before{background:var(--crit)}.status.missing::before,.status.off::before{background:var(--axis)}.status.warn::before{background:var(--warn)}
@media print{.topbar,.foot{position:static}.controls,.tabs{display:none}}

</style>
</head>
<body>
<header class="topbar">
  <div class="topbar-in">
    <div class="brand">
      <svg class="logo" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <ellipse cx="12" cy="12" rx="10" ry="6.2" transform="rotate(-35 12 12)" fill="var(--s2)"></ellipse>
        <path d="M8.2 15.8l7.6-7.6M10 12.4l1.6 1.6M11.6 10.8l1.6 1.6M13.2 9.2l1.6 1.6" stroke="#fff" stroke-width="1.4" stroke-linecap="round"></path>
      </svg>
      <h1>Dynasty Cockpit</h1>
      <span class="league" id="leagueName"></span>
    </div>
    <div class="chips" id="chips"></div>
    <div class="controls" id="controls"></div>
    <nav class="tabs" id="tabs" role="tablist" aria-label="Bereiche"></nav>
  </div>
</header>
<main id="view" aria-live="polite"></main>
<footer class="foot" id="foot"></footer>
<div class="toast" id="toast" role="status"></div>

<script>
'use strict';
/* ==========================================================================
   Dynasty Cockpit für Sleeper
   Eine HTML-Datei, keine Abhängigkeiten, keine Zugangsdaten.
   Liga: Sleeper API (öffentlich, nur lesend).
   Werte: FantasyCalc, Dynasty Dealer, RosterAudit, DynastyProcess (live),
          FantasyPros Trade Value Chart (Import als CSV, lokal gespeichert).
   ========================================================================== */

const APP = { version: '1.2.0' };

/* ---------- Speicher (localStorage, immer mit try/catch) ---------- */
const LS = {
  get(k, d = null) { try { const v = localStorage.getItem(k); return v == null ? d : JSON.parse(v); } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { return false; } },
  del(k) { try { localStorage.removeItem(k); } catch (e) { /* ignorieren */ } },
