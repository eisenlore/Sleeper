    { key: 'rk', label: 'Rang', num: true, nosort: true },
  ], [
    { l: 'Startelf (Marktwert)', me: fInt(r.starterMv), med: fInt(b.med.starterMv), rk: rankOf('starterMv') + '/' + n },
    { l: 'Bank', me: fInt(r.benchMv), med: fInt(b.med.benchMv), rk: rankOf('benchMv') + '/' + n },
    { l: 'davon Talente unter 24', me: fInt(r.youngBench), med: fInt(b.med.youngBench), rk: rankOf('youngBench') + '/' + n },
    { l: 'Picks', me: fInt(r.picksMv), med: fInt(b.med.picksMv), rk: rankOf('picksMv') + '/' + n },
    { l: 'Anteil in der Startelf', me: fPct(r.share), med: fPct(b.med.share), rk: rankOf('share') + '/' + n },
  ]);
  const gaps = D.fmt.groups.map(g => ({ g, me: r.byPos[g], med: b.medPos[g], d: r.byPos[g] - b.medPos[g] })).sort((a, z) => a.d - z.d);
  const tbl2 = dataTable('wa_gap', [
    { key: 'g', label: 'Position', nosort: true, render: o => posTag(o.g) },
    { key: 'me', label: 'Du', num: true, nosort: true, fmt: fInt },
    { key: 'med', label: 'Median', num: true, nosort: true, fmt: fInt },
    { key: 'd', label: 'Differenz', num: true, nosort: true, render: o => h('span', { class: o.d < 0 ? 'crit-t' : o.d > 0 ? 'good-t' : '' }, fSigned(o.d)) },
  ], gaps);
  const pr = b.proj.get(me.rid) || [];
  const tbl3 = dataTable('wa_fen', [
    { key: 'year', label: 'Saison', nosort: true },
    { key: 'total', label: 'Startelf-Kraft', num: true, nosort: true, fmt: fInt },
    { key: 'rank', label: 'Rang', num: true, nosort: true, render: o => o.rank + '/' + n },
    { key: 'gap', label: 'zur Spitze', num: true, nosort: true, render: o => o.top > 0 ? fSignedPct(o.total / o.top - 1) : NA },
  ], pr);
  // Erklärung in Klartext
  const txt = [];
  if (pr.length) {
    const p0 = pr[0];
    txt.push('Startelf-Kraft ' + p0.year + ': Rang ' + p0.rank + ', ' + (p0.rank === 1 ? 'Spitze' : fSignedPct(p0.total / p0.top - 1) + ' zur Spitze') + '. ' + p0.within5 + ' Teams liegen innerhalb von 5 % zur Spitze' + (p0.within5 >= Math.ceil(n / 2) ? ', die Ränge übertreiben die Unterschiede.' : '.'));
  }
  txt.push(fPct(1 - r.share) + ' deines Kaderwerts liegt auf Bank und Picks (Liga-Median ' + fPct(1 - b.med.share) + '). Kaderwert zählt alles, Startelf-Kraft nur die beste mögliche Aufstellung.');
  const neg = gaps.filter(o => o.d < 0).slice(0, 2);
  if (neg.length) txt.push('Größte Lücken in der Startelf: ' + neg.map(o => o.g + ' (' + fSigned(o.d) + ')').join(', ') + '.');
  const top = gaps[gaps.length - 1];
  if (neg.length && top && top.d > 0 && top.d >= Math.abs(neg[0].d) * 0.5) txt.push('Gleichzeitig Überschuss bei ' + top.g + ' (' + fSigned(top.d) + '): Dieser Wert hat in der Startelf nur begrenzt Platz. Überschuss gegen die Lücke tauschen bringt am meisten.');
  if (pr.length === 3 && S.settings.mode === 'win') {
    const d = pr[0].rank - pr[2].rank;
    if (d >= 2) txt.push('Mit der Alterskurve steigt deine Startelf bis ' + pr[2].year + ' auf Rang ' + pr[2].rank + ': Deine Talente brauchen Zeit. Für ' + pr[0].year + ' hilft nur, Bank und Picks in fertige Starter zu tauschen.');
    else if (d <= -2) txt.push('Bis ' + pr[2].year + ' fällt deine Startelf auf Rang ' + pr[2].rank + ': Der Kader altert schneller als die Konkurrenz.');
    else txt.push('Bis ' + pr[2].year + ' ändert sich dein Rang kaum (' + pr[2].rank + '). Zeit allein löst es nicht, die Lücken in der Startelf müssen über Trades geschlossen werden.');
  } else if (S.settings.mode !== 'win') txt.push('Fenster-Verlauf nur im Modus ' + TY() + ' maximieren aussagekräftig, im Modus Dynasty neutral gibt es keine Alterskurve.');
  return card('Kaderwert gegen Startelf', 'Warum ein hoher Kaderwert nicht automatisch eine starke ' + TY() + '-Startelf ist. Startelf = beste mögliche Aufstellung nach ' + TY() + '-Wert.',
    h('ul', { class: 'lage', style: { marginBottom: '12px' } }, txt.map(t => h('li', null, t))),
    h('div', { class: 'grid' },
      col('c4', h('div', null, h('h3', null, 'Wo steckt dein Kaderwert?'), tbl1)),
      col('c4', h('div', null, h('h3', null, 'Lücken in der Startelf (' + TY() + '-Wert)'), tbl2)),
      col('c4', h('div', null, h('h3', null, 'Fenster-Verlauf (gleicher Kader, Alterskurve)'), tbl3))));
}

/* ==========================================================================
   Start, Ladeanzeige, Export
   ========================================================================== */
const STEPS = [
  ['sleeper', 'Sleeper Liga'], ['matchups', 'Wochenergebnisse'], ['proj', 'Projektionen'], ['players', 'Spielerdatenbank'],
  ['src_fc', 'FantasyCalc'], ['src_dd', 'Dynasty Dealer'], ['src_ra', 'RosterAudit'], ['src_dp', 'DynastyProcess'], ['src_fp', 'FantasyPros (Import)'], ['src_idp', 'IDP-Werte (FantasyPros)'],
];
let LOADSTATE = {};
let BOOTING = false;
function showLoading() {
  LOADSTATE = {};
  const view = clear($('#view'));
  view.appendChild(h('div', { class: 'loading card' }, h('h2', null, 'Lade Daten'), h('p', { class: 'sub' }, 'Liga ' + CFG.leagueId + ' · ' + CFG.username), h('ul', { class: 'steps', id: 'steps' })));
  paintSteps();
}
function progress(id, st, note) { LOADSTATE[id] = { st, note }; paintSteps(); }
function paintSteps() {
  const list = $('#steps'); if (!list) return;
  clear(list);
  for (const [id, label] of STEPS) {
    const s = LOADSTATE[id];
    const st = s ? s.st : 'pending';
    const ic = st === 'ok' ? '✓' : st === 'err' ? '✕' : st === 'warn' ? '!' : st === 'loading' ? '…' : '·';
    list.appendChild(h('li', null, h('span', { class: 'st ' + st }, ic), h('span', null, label), h('span', { class: 'note' }, s && s.note ? s.note : '')));
  }
}
function showFatal(e) {
  clear($('#chips')); clear($('#controls')); clear($('#tabs'));
  const view = $('#view');
  const msg = String(e && e.message || e);
  view.appendChild(h('div', { class: 'grid', style: { maxWidth: '760px', margin: '16px auto 0' } },
    col('c12', card('Laden fehlgeschlagen', msg,
      h('ul', { class: 'lage' },
        h('li', null, 'League ID und Username unten prüfen.'),
        h('li', null, 'Datei über GitHub Pages oder einen Webserver öffnen. Manche Browser blockieren Anfragen aus lokal geöffneten Dateien.'),
        h('li', null, 'Werbe- oder Tracking-Blocker können api.sleeper.app sperren.'),
        h('li', null, 'Firmennetz oder VPN kann die Sleeper-API blockieren.')),
      h('div', { class: 'row', style: { marginTop: '12px' } }, h('button', { class: 'btn primary', onclick: () => boot({}) }, 'Erneut versuchen')))),
    col('c12', settingsCard())));
}
async function boot(opts = {}) {
  if (BOOTING) return;
  BOOTING = true;
  applyTheme();
  showLoading();
  try {
    const sl = await loadSleeper(progress);
    S.sl = sl;
    D.fmt = deriveFormat(sl);
    D.teams = buildTeams(sl);
    D.byRid = new Map(D.teams.map(t => [t.rid, t]));
    const rostered = new Set(D.teams.flatMap(t => t.players));
    S.players = await loadPlayers(!!opts.forcePlayers, rostered, progress);
    buildNameIndex(S.players);
    [S.src, S.idp] = await Promise.all([loadAllSources(D.fmt, !!opts.forceValues, progress), loadIDPSource(D.fmt, !!opts.forceValues, progress)]);
    buildBase();
    recompute();
    if (S.calc.partner != null && !D.byRid.has(S.calc.partner)) S.calc = { partner: null, give: [], get: [] };
    if (S.finder.partner !== 'all' && !D.byRid.has(Number(S.finder.partner))) S.finder.partner = 'all';
    if (!['all', 'contender', 'out'].includes(S.gen.partner) && !D.byRid.has(Number(S.gen.partner))) S.gen.partner = 'all';
    S.loadedAt = new Date();
    render();
  } catch (e) {
    console.error(e);
    showFatal(e);
  } finally { BOOTING = false; }
}

/** Pseudonymisierter Export: keine Usernamen, Teams als Team A bis Z */
function buildExport() {
  const f = D.fmt, me = D.me;
  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const alias = new Map(); let i = 0;
  const ordered = D.teams.slice().sort((a, b) => a.rkStand - b.rkStand);
  for (const t of ordered) alias.set(t.rid, t.isMe ? 'ICH' : 'Team ' + letters[i++ % 26]);
  const fl = formatLabel(f);
  const P = x => ({ name: x.name, pos: x.pos, nfl: x.nfl || 'FA', alter: x.ageNow != null ? round1(x.ageNow) : null, marktwert: Math.round(x.mv), wertZielsaison: Math.round(x.v27), jetztPktProWoche: round1(x.nowPts), ppg: round1(x.ppg), spiele: x.games, status: x.inj || 'fit', signal: sigLabel(x.signal), rolle: x.starter ? 'Starter' : x.onIR ? 'IR' : x.onTaxi ? 'Taxi' : 'Bank' });
  const pickTxt = key => { const pk = D.pickByKey.get(key); if (!pk) return key; return pickShort(key) + (pk.orig !== pk.owner ? ' (urspr. ' + alias.get(pk.orig) + ')' : ''); };
  return {
    erstellt: new Date().toISOString(), tool: 'Dynasty Cockpit ' + APP.version, zielsaison: Number(TY()),
    hinweis: 'Pseudonymisiert: Teams als Team A bis Z, keine Usernamen.',
    liga: { saison: f.season, woche: f.curWeek, typ: fl.typ, qb: fl.qb, scoring: fl.sc, teams: f.teams, deadline: deadlineInfo(f).text, startplaetze: f.slots.join(','), playoffTeams: f.playoffTeams, pickreihenfolge: D.pickOrderSource === 'Draft' ? 'aus Sleeper-Draft' : D.pickOrderSource === 'offen' ? 'noch offen' : 'Annahme umgekehrte Tabelle' },
    einstellungen: { quelle: srcName(D.srcId), modus: S.settings.mode === 'win' ? '' + TY() + ' maximieren' : 'Dynasty neutral', fairness: (BANDS[S.settings.band] || {}).label },
    quellen: SRC_DEF.map(d => ({ quelle: d.name, status: S.src[d.id] ? S.src[d.id].status : 'fehlt', stand: (S.src[d.id] && S.src[d.id].updated) || null })),
    teams: ordered.map(t => ({ team: alias.get(t.rid), platz: t.rkStand, bilanz: recordStr(t), pf: round1(t.fpts), modus: MODE_LABEL[t.mode], jetztStaerke: round1(t.nowLineup.total), kraftZielsaison: Math.round(t.lineup27.total), kaderwert: Math.round(t.mvTotal), pickwert: Math.round(t.mvPicks), alter: t.age != null ? round1(t.age) : null, bedarf: t.needs, noten: Object.fromEntries(['QB', 'RB', 'WR', 'TE', 'PICK'].map(p => [p, t['g_' + p] ? t['g_' + p].grade : null])) })),
    meinKader: me ? me.players.map(pid => D.pl.get(pid)).filter(Boolean).sort((a, b) => b.mv - a.mv).map(P) : [],
    meinePicks: me ? me.picksOwned.map(pk => ({ pick: pk.season + ' R' + pk.round, herkunft: pk.orig === pk.owner ? 'eigener' : 'von ' + alias.get(pk.orig), projektion: pk.slot ? pk.round + '.' + String(pk.slot).padStart(2, '0') : null, marktwert: Math.round(pk.mv) })) : [],
    vorschlaege: D.sugg.slice(0, 10).map(s => ({ partner: alias.get(s.team.rid), gibst: s.give.map(a => a.label), bekommst: s.get.map(a => a.kind === 'k' ? pickTxt(a.id) : a.label), wertverhaeltnis: round1((s.ratio - 1) * 100) + ' %', startelfZielsaison: Math.round(s.my27), partnerJetztPkt: round1(s.tNow) })),
    kaufziele: D.targets.slice(0, 15).map(r => ({ name: r.x.name, pos: r.x.pos, besitzer: alias.get(r.team.rid), grund: r.reason, marktwert: Math.round(r.x.mv), wertZielsaison: Math.round(r.x.v27) })),
  };
}

