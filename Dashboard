/* ---------- Picks: Besitz, Projektion ---------- */
function projectedOrder() {
  const fmt = D.fmt, n = D.teams.length;
  const draft = (S.sl.drafts || []).find(d => Number(d.season) === fmt.firstPickSeason && (d.slot_to_roster_id || d.draft_order));
  const slotOf = new Map();
  let source = 'Tabelle';
  if (draft && draft.slot_to_roster_id) { for (const [slot, rid] of Object.entries(draft.slot_to_roster_id)) slotOf.set(Number(rid), Number(slot)); source = 'Draft'; }
  else if (draft && draft.draft_order) { const byOwner = new Map(D.teams.map(t => [t.ownerId, t.rid])); for (const [uid, slot] of Object.entries(draft.draft_order)) { const rid = byOwner.get(String(uid)); if (rid != null) slotOf.set(rid, Number(slot)); } source = 'Draft'; }
  if (slotOf.size < n && fmt.firstPickSeason === fmt.season) { slotOf.clear(); return { slotOf, source: 'offen' }; } // neue Saison ohne Ergebnisse
  if (slotOf.size < n) {
    slotOf.clear(); source = 'Tabelle';
    const worstFirst = D.teams.slice().sort((a, b) => b.rkStand - a.rkStand);
    worstFirst.forEach((t, i) => slotOf.set(t.rid, i + 1));
