  let mx = 0; for (const row of w) for (const v of row) if (v > mx) mx = v;
  const u = new Float64Array(m + 1), v = new Float64Array(n + 1);
  const p = new Int32Array(n + 1), way = new Int32Array(n + 1);
  for (let i = 1; i <= m; i++) {
