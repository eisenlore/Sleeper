    getJSON(SL + 'league/' + lid + '/traded_picks').catch(() => []),
    getJSON(SL + 'league/' + lid + '/drafts').catch(() => []),
  ]);
  if (!league || !league.league_id) throw new Error('Liga ' + CFG.leagueId + ' nicht gefunden.');
  let myUserId = null;
  try { const u = await getJSON(SL + 'user/' + encodeURIComponent(CFG.username)); if (u && u.user_id) myUserId = String(u.user_id); } catch (e) { /* Rückfall unten */ }
  if (!myUserId) {
