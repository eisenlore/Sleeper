  for (const t of S.sl.traded || []) { const s = Number(t.season); if (s >= fmt.firstPickSeason) seasons.add(s); }
  const owner = new Map();
  for (const t of S.sl.traded || []) owner.set(Number(t.season) + '-' + Number(t.round) + '-' + Number(t.roster_id), Number(t.owner_id));
  const { slotOf, source } = projectedOrder();
