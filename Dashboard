function parsePickName(name) {
  const s = String(name || '').trim();
  let m = s.match(/^(\d{4})\s+(?:Pick\s+)?(\d{1,2})\.(\d{1,2})$/i);
  if (m) return { season: +m[1], round: +m[2], slot: +m[3], tier: null };
  m = s.match(/^(\d{4})\s+(Early|Mid|Late)\s+(\d)(?:st|nd|rd|th)$/i);
  if (m) return { season: +m[1], round: +m[3], tier: m[2].toLowerCase(), slot: null };
  m = s.match(/^(\d{4})\s+(\d)(?:st|nd|rd|th)(?:\s*\((Early|Mid|Late)\))?$/i);
  if (m) return { season: +m[1], round: +m[2], tier: m[3] ? m[3].toLowerCase() : null, slot: null };
  m = s.match(/^(\d{4})\s+Round\s+(\d)(?:\s+(Early|Mid|Late))?$/i);
  if (m) return { season: +m[1], round: +m[2], tier: m[3] ? m[3].toLowerCase() : null, slot: null };
  return null;
}

